// Cloudflare deploy settings for the app.
// For now the Worker only serves the existing static files (index.html, icons, manifest).
// No secrets in this file: API keys go into Cloudflare dashboard secrets only.
{
  "name": "wooui",
  "compatibility_date": "2026-11-01",
  // Turn on the wooui.<account>.workers.dev address
  "workers_dev": true,
  // No extra per-version preview addresses (keeps only one address to lock)
  "preview_urls": false,
  "assets": {
    "directory": "./"
  }
}
